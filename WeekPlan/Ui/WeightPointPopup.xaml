<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeekPlan.App.Ui.WeightPointPopup"
             HorizontalOptions="Center"
             WidthRequest="320">
    <Border x:Name="Card" Padding="20" BackgroundColor="#FFFCF7">
        <VerticalStackLayout Spacing="12">
            <Label x:Name="HeadingLabel" FontSize="22" FontAttributes="Bold" TextColor="#1B1F2A" />
            <Entry x:Name="WeightEntry" Keyboard="Text" Placeholder="千克" />
            <Label x:Name="ErrorLabel" TextColor="#8C3A32" IsVisible="False" />
            <Button x:Name="SaveButton" Text="保存" Clicked="OnSave"
                    BackgroundColor="#22C55E" TextColor="White" CornerRadius="18" HeightRequest="44" FontAttributes="Bold" />
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                <Button Text="取消" Clicked="OnCancel" />
                <Button x:Name="DeleteButton" Grid.Column="1" Text="删除" Clicked="OnDelete" BackgroundColor="#8C3A32" TextColor="White" />
            </Grid>
        </VerticalStackLayout>
    </Border>
</ContentView>
