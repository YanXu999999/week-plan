<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeekPlan.App.Ui.RootPage"
             BackgroundColor="#F7F8FB">
    <Grid>
        <Grid x:Name="ScreenHost" />
        <Grid x:Name="PopupLayer" IsVisible="False">
            <Grid x:Name="PopupMask" BackgroundColor="#80000000" InputTransparent="False">
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnPopupMaskTapped" />
                </Grid.GestureRecognizers>
            </Grid>
            <Grid x:Name="PopupHost" VerticalOptions="Center" Margin="20,0" />
        </Grid>
        <Border x:Name="ExitHint" IsVisible="False" InputTransparent="True"
                HorizontalOptions="Center" VerticalOptions="End" Margin="24,0,24,76"
                Padding="18,12" BackgroundColor="#1B1F2A" StrokeThickness="0">
            <Label Text="再按一次退出训练周" TextColor="White" FontSize="15" />
        </Border>
    </Grid>
</ContentPage>
