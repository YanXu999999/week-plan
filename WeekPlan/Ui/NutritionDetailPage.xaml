<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="WeekPlan.App.Ui.NutritionDetailPage"
             BackgroundColor="#F7F8FB">
    <Grid RowDefinitions="Auto,*" Padding="20,12,20,20" RowSpacing="8">
        <Grid ColumnDefinitions="Auto,*">
            <HorizontalStackLayout Spacing="4" Padding="0,8" HorizontalOptions="Start" BackgroundColor="#F7F8FB">
                <HorizontalStackLayout.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnBackClicked" />
                </HorizontalStackLayout.GestureRecognizers>
                <Label Text="←" FontSize="20" TextColor="#22C55E" VerticalOptions="Center" InputTransparent="True" />
                <Label Text="返回" FontSize="16" TextColor="#22C55E" VerticalOptions="Center" InputTransparent="True" />
            </HorizontalStackLayout>
            <Button Grid.Column="1" Text="记一笔" HorizontalOptions="End" BackgroundColor="Transparent"
                    TextColor="#1F6B4A" Padding="0,8" Clicked="OnAddClicked" />
        </Grid>
        <ScrollView Grid.Row="1">
            <VerticalStackLayout Spacing="12">
                <Label x:Name="DateLabel" FontSize="28" FontAttributes="Bold" TextColor="#1B1F2A" />
                <Grid ColumnDefinitions="Auto,*">
                    <Label Text="汇总" FontSize="14" TextColor="#8E95A3" VerticalOptions="Center" />
                    <HorizontalStackLayout Grid.Column="1" Spacing="8" HorizontalOptions="End">
                        <Button Text="？" FontSize="13" Padding="10,6" BackgroundColor="#F4F1EA" TextColor="#1C1B19" Clicked="OnGoalHelpClicked" />
                        <Button x:Name="CutButton" Text="减脂" FontSize="13" Padding="10,6" Clicked="OnCutClicked" />
                        <Button x:Name="KeepButton" Text="增肌、维持" FontSize="13" Padding="10,6" Clicked="OnKeepClicked" />
                    </HorizontalStackLayout>
                </Grid>
                <VerticalStackLayout x:Name="SummaryHost" Spacing="10" />
                <Label Text="单项食物" FontSize="14" TextColor="#8E95A3" Margin="0,8,0,0" />
                <Label x:Name="EmptyFoodsLabel" Text="这一天还没有摄入" FontSize="16" TextColor="#8E95A3" />
                <VerticalStackLayout x:Name="FoodHost" Spacing="10" />
            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentView>
